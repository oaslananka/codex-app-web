{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerOauthLoginParams",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "clientRegistration": {
      "description": "Registration strategy for this login only; omission selects automatic discovery.",
      "anyOf": [
        {
          "$ref": "#/definitions/McpServerOauthClientRegistration"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "scopes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeoutSecs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    }
  },
  "definitions": {
    "McpServerOauthClientRegistration": {
      "type": "string",
      "enum": [
        "auto",
        "cimd",
        "dcr"
      ]
    }
  }
}
