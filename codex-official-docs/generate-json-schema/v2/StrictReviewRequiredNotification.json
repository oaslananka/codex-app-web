{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrictReviewRequiredNotification",
  "type": "object",
  "required": [
    "startedAtMs",
    "threadId",
    "turnId"
  ],
  "properties": {
    "startedAtMs": {
      "description": "Unix timestamp (in milliseconds) when this review started.",
      "type": "integer",
      "format": "int64"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  }
}
